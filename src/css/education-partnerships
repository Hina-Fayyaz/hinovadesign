:root {
  --bg-dark: #1e1e1e;
  --bg-darker: #111111;
  --bg-light: #f1efe5;
  --paper: #fffdf8;
  --white: #ffffff;
  --primary: #fd51ab;
  --secondary: #bee82a;
  --text-dark: #ffffff;
  --text-light: #000000;
  --text-muted: #4a4a4a;
  --line-dark: rgba(255, 255, 255, 0.15);
  --line-light: rgba(30, 30, 30, 0.12);
  --font-serif: "Libre Baskerville", Georgia, serif;
  --font-sans: "DM Sans", Arial, sans-serif;
  --font-mono: "Montserrat", Arial, sans-serif;
  --shadow: 0 26px 70px -34px rgba(30, 30, 30, 0.35);
  --radius-sm: 14px;
  --radius-md: 22px;
  --radius-lg: 32px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  margin: 0;
  background: var(--bg-dark);
  color: var(--text-light);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.65;
  text-rendering: optimizeLegibility;
}

body,
button,
input,
textarea {
  font-family: var(--font-sans);
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
summary {
  font: inherit;
}

h1,
h2,
h3,
p,
ol,
ul {
  margin-top: 0;
}

:where(a, button, summary, [tabindex]):focus-visible {
  outline: 3px solid var(--secondary);
  outline-offset: 4px;
}

.skip-link {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 999;
  padding: 11px 18px;
  border-radius: 999px;
  background: var(--bg-dark);
  color: var(--white);
  font-weight: 700;
  transform: translateY(-180%);
  transition: transform 0.2s ease;
}

.skip-link:focus {
  transform: translateY(0);
}

.section-shell,
.nav-shell {
  width: min(1180px, calc(100% - 48px));
  margin-inline: auto;
}

.section-cream {
  background: var(--bg-light);
}

.eyebrow,
.tag {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.11em;
  line-height: 1.3;
  text-transform: uppercase;
}

.tag {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  margin-bottom: 24px;
  padding: 8px 14px;
  border-radius: 999px;
  background: var(--secondary);
  color: var(--text-light);
}

.eyebrow {
  margin-bottom: 15px;
  color: var(--primary);
}

.button-primary,
.button-secondary {
  min-height: 54px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  border-radius: 999px;
  font-weight: 700;
  line-height: 1;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease,
    color 0.2s ease;
}

.button-primary {
  padding: 9px 10px 9px 24px;
  border: 2px solid var(--bg-dark);
  background: var(--bg-dark);
  color: var(--white);
}

.button-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 34px rgba(30, 30, 30, 0.24);
}

.button-arrow {
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--secondary);
  color: var(--bg-dark);
  font-size: 1.1rem;
}

.button-secondary {
  padding: 13px 26px;
  border: 2px solid var(--bg-dark);
  color: var(--bg-dark);
}

.button-secondary:hover {
  transform: translateY(-2px);
  background: var(--white);
}

.button-dots {
  display: grid;
  grid-template-columns: repeat(2, 7px);
  gap: 3px;
}

.button-dots i {
  width: 7px;
  height: 7px;
  border-radius: 2px;
  background: var(--primary);
}

.button-compact {
  min-height: 46px;
  padding: 7px 8px 7px 19px;
  font-size: 0.88rem;
}

.button-compact .button-arrow {
  width: 30px;
  height: 30px;
  flex-basis: 30px;
}

.external-mark {
  display: inline-block;
  margin-left: 3px;
  font-size: 0.92em;
}

/* Header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid rgba(30, 30, 30, 0.06);
  background: rgba(241, 239, 229, 0.96);
  backdrop-filter: blur(14px);
}

.nav-shell {
  min-height: 80px;
  display: flex;
  align-items: center;
  gap: 28px;
}

.brand-link {
  min-width: 238px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-link img {
  width: 44px;
  height: 44px;
  object-fit: contain;
  border-radius: 10px;
}

.brand-link > span {
  display: grid;
  line-height: 1.15;
}

.brand-link strong {
  font-size: 0.98rem;
}

.brand-link small {
  margin-top: 4px;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.desktop-nav {
  flex: 1;
  display: flex;
  justify-content: center;
  gap: clamp(18px, 2.4vw, 34px);
}

.desktop-nav a {
  color: var(--text-muted);
  font-size: 0.9rem;
  font-weight: 600;
  white-space: nowrap;
}

.desktop-nav a:hover {
  color: var(--primary);
}

.mobile-menu {
  display: none;
}

/* Hero */
.hero {
  position: relative;
  overflow: hidden;
  padding: 104px 0 100px;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-orb-pink {
  width: 290px;
  height: 290px;
  top: -165px;
  right: -70px;
  border: 58px solid rgba(253, 81, 171, 0.16);
}

.hero-orb-lime {
  width: 180px;
  height: 180px;
  bottom: -105px;
  left: 5%;
  background: rgba(190, 232, 42, 0.2);
}

.hero-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
  align-items: center;
  gap: clamp(54px, 7vw, 96px);
}

.hero-copy h1 {
  max-width: 720px;
  margin-bottom: 26px;
  color: var(--text-light);
  font-family: var(--font-serif);
  font-size: clamp(3.2rem, 5.8vw, 5.25rem);
  font-weight: 700;
  letter-spacing: -0.045em;
  line-height: 1.04;
}

.hero-copy h1 em,
.section-heading h2 em,
.contact-copy h2 em {
  color: var(--primary);
  font-weight: 700;
}

.hero-lede {
  max-width: 700px;
  margin-bottom: 32px;
  color: rgba(30, 30, 30, 0.76);
  font-size: 1.09rem;
  line-height: 1.8;
}

.hero-actions,
.proof-actions,
.contact-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
}

.hero-proof {
  margin: 24px 0 0;
  color: var(--text-muted);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.hero-proof span {
  margin-inline: 6px;
  color: var(--primary);
}

.hero-system {
  position: relative;
  padding: 26px;
  border-radius: var(--radius-lg);
  background: var(--bg-dark);
  color: var(--white);
  box-shadow: 0 34px 80px -34px rgba(30, 30, 30, 0.65);
}

.hero-system::after {
  content: "";
  position: absolute;
  right: 25px;
  bottom: -16px;
  width: 116px;
  height: 32px;
  border-radius: 0 0 18px 18px;
  background: var(--primary);
  z-index: -1;
}

.system-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 21px;
  padding: 0 4px 15px;
  border-bottom: 1px solid var(--line-dark);
  color: var(--secondary);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.system-flow {
  display: grid;
  gap: 11px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.system-flow li {
  position: relative;
  display: grid;
  grid-template-columns: 48px 1fr;
  align-items: center;
  gap: 14px;
  min-height: 76px;
  padding: 13px 15px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.045);
}

.system-flow li:not(:last-child)::after {
  content: "↓";
  position: absolute;
  bottom: -17px;
  left: 30px;
  z-index: 2;
  display: grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--secondary);
  color: var(--bg-dark);
  font-size: 0.75rem;
  font-weight: 900;
}

.system-flow li > span {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: var(--bg-light);
  color: var(--bg-dark);
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
}

.system-flow li:nth-child(2) > span {
  background: var(--secondary);
}

.system-flow li:nth-child(3) > span {
  background: var(--primary);
}

.system-flow strong,
.system-flow small {
  display: block;
}

.system-flow strong {
  margin-bottom: 2px;
  font-size: 0.96rem;
}

.system-flow small {
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.75rem;
}

.system-note {
  margin: 18px 5px 0;
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.75rem;
  line-height: 1.55;
}

/* Evidence */
.evidence-band {
  padding: 92px 0 82px;
  background: var(--bg-dark);
  color: var(--white);
}

.evidence-intro {
  max-width: 760px;
  margin-bottom: 42px;
}

.evidence-intro h2,
.section-heading h2,
.pilot-intro h2,
.proof-copy h2,
.faq-heading h2,
.contact-copy h2,
.references-grid h2 {
  font-family: var(--font-serif);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.17;
}

.evidence-intro h2 {
  margin-bottom: 15px;
  font-size: clamp(2.2rem, 4.2vw, 3.65rem);
}

.evidence-intro > p:last-child {
  max-width: 650px;
  margin-bottom: 0;
  color: rgba(255, 255, 255, 0.65);
  font-size: 1rem;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.metric-card {
  min-height: 292px;
  display: flex;
  flex-direction: column;
  padding: 26px;
  border-radius: var(--radius-md);
  color: var(--bg-dark);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.metric-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 22px 40px -24px rgba(0, 0, 0, 0.72);
}

.metric-1 {
  background: var(--secondary);
}

.metric-2 {
  background: var(--primary);
}

.metric-3 {
  background: var(--bg-light);
}

.metric-4 {
  border: 1px solid rgba(255, 255, 255, 0.23);
  background: rgba(255, 255, 255, 0.07);
  color: var(--white);
}

.metric-value {
  margin-bottom: 22px;
  font-family: var(--font-serif);
  font-size: clamp(3rem, 4vw, 4.25rem);
  font-weight: 700;
  letter-spacing: -0.06em;
  line-height: 1;
}

.metric-card > strong {
  margin-bottom: 9px;
  font-size: 0.98rem;
  line-height: 1.35;
}

.metric-card > small {
  color: currentColor;
  font-size: 0.72rem;
  line-height: 1.5;
  opacity: 0.68;
}

.metric-source {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 22px;
  border-top: 1px solid currentColor;
  font-size: 0.72rem;
  font-weight: 700;
  opacity: 0.75;
}

.data-note {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 7px;
  margin: 24px 0 0;
  color: rgba(255, 255, 255, 0.53);
  font-size: 0.75rem;
}

.data-note a {
  color: var(--secondary);
  font-weight: 700;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

/* Challenges */
.challenge-section,
.pilot-section,
.proof-section {
  padding: 108px 0;
}

.section-heading {
  margin-bottom: 48px;
}

.split-heading {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(290px, 0.65fr);
  align-items: end;
  gap: 74px;
}

.section-heading h2 {
  max-width: 780px;
  margin-bottom: 0;
  font-size: clamp(2.45rem, 4.9vw, 4.4rem);
}

.split-heading > p,
.light-heading > p {
  margin-bottom: 4px;
  color: var(--text-muted);
  font-size: 0.98rem;
}

.challenge-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 16px;
}

.challenge-card {
  grid-column: span 2;
  min-height: 420px;
  display: flex;
  flex-direction: column;
  padding: 28px;
  border: 1px solid var(--line-light);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.53);
}

.challenge-card:nth-child(4),
.challenge-card:nth-child(5) {
  grid-column: span 3;
  min-height: 370px;
}

.challenge-number {
  width: fit-content;
  margin-bottom: 34px;
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--bg-dark);
  color: var(--secondary);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
}

.challenge-card h3 {
  margin-bottom: 13px;
  font-family: var(--font-serif);
  font-size: 1.45rem;
  line-height: 1.3;
}

.challenge-card > p {
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.72;
}

.design-response {
  margin-top: auto;
  padding-top: 20px;
  border-top: 1px solid var(--line-light);
}

.design-response span,
.design-response strong {
  display: block;
}

.design-response span {
  margin-bottom: 7px;
  color: var(--primary);
  font-family: var(--font-mono);
  font-size: 0.61rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.design-response strong {
  font-size: 0.83rem;
  line-height: 1.55;
}

.scope-banner {
  display: grid;
  grid-template-columns: 104px 1fr;
  gap: 28px;
  margin-top: 18px;
  padding: 35px;
  border-radius: var(--radius-md);
  background: var(--bg-dark);
  color: var(--white);
}

.scope-mark {
  display: grid;
  place-items: center;
  width: 92px;
  height: 92px;
  border-radius: 50%;
  background: var(--primary);
  color: var(--bg-dark);
  font-family: var(--font-serif);
  font-size: 3.2rem;
  font-weight: 700;
}

.scope-banner h3 {
  margin-bottom: 10px;
  font-family: var(--font-serif);
  font-size: 1.65rem;
}

.scope-banner p:last-child {
  max-width: 870px;
  margin-bottom: 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.92rem;
}

/* Approach */
.approach-section {
  padding: 108px 0;
  background: var(--bg-dark);
  color: var(--white);
}

.light-heading > p {
  color: rgba(255, 255, 255, 0.62);
}

.solution-table {
  border: 1px solid var(--line-dark);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.solution-row {
  display: grid;
  grid-template-columns: 1.05fr 1.15fr 1fr;
  border-bottom: 1px solid var(--line-dark);
}

.solution-row:last-child {
  border-bottom: 0;
}

.solution-row > span,
.solution-row > div {
  min-width: 0;
  padding: 22px 24px;
  border-right: 1px solid var(--line-dark);
}

.solution-row > :last-child {
  border-right: 0;
}

.solution-header {
  background: var(--secondary);
  color: var(--bg-dark);
  font-family: var(--font-mono);
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.solution-row:not(.solution-header) > div {
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.86rem;
  line-height: 1.55;
}

.solution-row:not(.solution-header) > div:first-child {
  display: grid;
  grid-template-columns: 30px 1fr;
  gap: 10px;
  color: var(--white);
}

.row-index {
  color: var(--primary);
  font-family: var(--font-mono);
  font-size: 0.64rem;
  font-weight: 700;
}

.principles-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-top: 18px;
}

.principles-grid article {
  min-height: 230px;
  padding: 25px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.055);
}

.principles-grid article:nth-child(2) {
  background: rgba(190, 232, 42, 0.12);
}

.principles-grid article:nth-child(3) {
  background: rgba(253, 81, 171, 0.12);
}

.principles-grid article > span {
  display: block;
  margin-bottom: 52px;
  color: var(--secondary);
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.principles-grid h3 {
  margin-bottom: 8px;
  font-family: var(--font-serif);
  font-size: 1.3rem;
}

.principles-grid p {
  margin-bottom: 0;
  color: rgba(255, 255, 255, 0.59);
  font-size: 0.82rem;
}

/* Pilot */
.pilot-intro {
  display: grid;
  grid-template-columns: 1fr 300px;
  align-items: end;
  gap: 70px;
  margin-bottom: 58px;
}

.pilot-intro h2 {
  max-width: 750px;
  margin-bottom: 0;
  font-size: clamp(2.5rem, 4.9vw, 4.3rem);
}

.pilot-promise {
  display: grid;
  gap: 6px;
  padding: 22px 24px;
  border-radius: var(--radius-md);
  background: var(--primary);
}

.pilot-promise strong {
  font-family: var(--font-serif);
  font-size: 2.35rem;
  letter-spacing: -0.04em;
  line-height: 1;
}

.pilot-promise span {
  font-size: 0.75rem;
  font-weight: 700;
}

.pilot-timeline {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.pilot-timeline li {
  min-width: 0;
  padding-right: 25px;
}

.phase-line {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.phase-line span {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--bg-dark);
  color: var(--secondary);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
}

.phase-line i {
  width: 100%;
  height: 1px;
  background: rgba(30, 30, 30, 0.22);
}

.pilot-timeline li:last-child .phase-line i {
  display: none;
}

.pilot-timeline small {
  color: var(--primary);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.pilot-timeline h3 {
  margin: 7px 0 10px;
  font-family: var(--font-serif);
  font-size: 1.42rem;
}

.pilot-timeline p {
  margin-bottom: 0;
  color: var(--text-muted);
  font-size: 0.84rem;
  line-height: 1.7;
}

.measurement-card {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 60px;
  margin-top: 64px;
  padding: 36px;
  border-radius: var(--radius-md);
  background: var(--primary);
}

.measurement-card h3 {
  margin-bottom: 0;
  font-family: var(--font-serif);
  font-size: 2rem;
}

.measurement-card .eyebrow {
  color: var(--bg-dark);
  opacity: 0.7;
}

.measurement-card ul {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 11px 28px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.measurement-card li {
  position: relative;
  padding-left: 21px;
  font-size: 0.84rem;
  font-weight: 600;
}

.measurement-card li::before {
  content: "";
  position: absolute;
  top: 0.62em;
  left: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--secondary);
}

/* Audience */
.audience-section {
  padding: 108px 0 88px;
  background: var(--paper);
}

.centered-heading {
  max-width: 850px;
  margin-inline: auto;
  text-align: center;
}

.centered-heading h2 {
  max-width: none;
}

.audience-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.audience-grid article {
  min-height: 280px;
  padding: 27px;
  border: 1px solid var(--line-light);
  border-radius: var(--radius-md);
}

.audience-grid article > span {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  margin-bottom: 64px;
  border-radius: 12px;
  background: var(--secondary);
  font-family: var(--font-mono);
  font-size: 0.64rem;
  font-weight: 700;
}

.audience-grid article:nth-child(2) > span {
  background: var(--primary);
}

.audience-grid article:nth-child(3) {
  background: var(--bg-dark);
  color: var(--white);
}

.audience-grid h3 {
  margin-bottom: 10px;
  font-family: var(--font-serif);
  font-size: 1.45rem;
}

.audience-grid p {
  margin-bottom: 0;
  color: var(--text-muted);
  font-size: 0.87rem;
}

.audience-grid article:nth-child(3) p {
  color: rgba(255, 255, 255, 0.62);
}

.partnership-rule {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 17px;
  padding: 18px 20px;
  border-radius: 16px;
  background: var(--bg-light);
  font-size: 0.76rem;
}

.partnership-rule strong {
  margin-right: 4px;
}

.partnership-rule span {
  padding: 6px 10px;
  border: 1px solid var(--line-light);
  border-radius: 999px;
  background: var(--white);
}

/* Proof */
.proof-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
  align-items: center;
  gap: clamp(55px, 8vw, 105px);
}

.proof-copy h2 {
  margin-bottom: 24px;
  font-size: clamp(2.45rem, 4.4vw, 4rem);
}

.proof-copy > p:last-of-type {
  max-width: 650px;
  margin-bottom: 32px;
  color: var(--text-muted);
}

.text-link {
  font-size: 0.85rem;
  font-weight: 700;
  text-decoration: underline;
  text-decoration-color: var(--primary);
  text-decoration-thickness: 2px;
  text-underline-offset: 5px;
}

.proof-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.proof-stat {
  min-height: 186px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 25px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

.proof-stat:first-child {
  grid-column: span 2;
  min-height: 225px;
}

.proof-stat-lime {
  background: var(--secondary);
}

.proof-stat-dark {
  background: var(--bg-dark);
  color: var(--white);
}

.proof-stat-pink {
  background: var(--primary);
}

.proof-stat strong,
.proof-stat span {
  display: block;
}

.proof-stat strong {
  margin-bottom: 8px;
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 4vw, 4rem);
  letter-spacing: -0.05em;
  line-height: 1;
}

.proof-stat span {
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

/* FAQ */
.faq-section {
  padding: 108px 0;
  background: var(--paper);
}

.faq-grid {
  display: grid;
  grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
  align-items: start;
  gap: 90px;
}

.faq-heading {
  position: sticky;
  top: 122px;
}

.faq-heading h2 {
  margin-bottom: 15px;
  font-size: clamp(2.5rem, 4vw, 3.65rem);
}

.faq-heading > p:last-child {
  color: var(--text-muted);
}

.faq-list {
  border-top: 1px solid var(--line-light);
}

.faq-list details {
  border-bottom: 1px solid var(--line-light);
}

.faq-list summary {
  min-height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 0;
  cursor: pointer;
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 700;
  list-style: none;
}

.faq-list summary::-webkit-details-marker {
  display: none;
}

.faq-list summary i {
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--bg-dark);
  color: var(--secondary);
  font-family: var(--font-sans);
  font-style: normal;
  transition: transform 0.2s ease;
}

.faq-list details[open] summary i {
  transform: rotate(45deg);
}

.faq-list details > p {
  max-width: 720px;
  margin-bottom: 27px;
  padding-right: 50px;
  color: var(--text-muted);
  font-size: 0.92rem;
}

/* Contact */
.contact-section {
  padding: 110px 0;
  background: var(--bg-dark);
  color: var(--white);
}

.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(390px, 0.95fr);
  align-items: center;
  gap: clamp(55px, 8vw, 105px);
}

.contact-copy h2 {
  max-width: 700px;
  margin-bottom: 22px;
  font-size: clamp(2.8rem, 5vw, 4.7rem);
}

.contact-copy > p:not(.tag):not(.response-time) {
  max-width: 650px;
  margin-bottom: 30px;
  color: rgba(255, 255, 255, 0.66);
}

.button-on-dark {
  border-color: var(--white);
  background: var(--white);
  color: var(--bg-dark);
}

.email-link {
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: underline;
  text-decoration-color: var(--primary);
  text-decoration-thickness: 2px;
  text-underline-offset: 5px;
}

.response-time {
  margin: 18px 0 0;
  color: rgba(255, 255, 255, 0.46);
  font-size: 0.74rem;
}

.brief-card {
  padding: 29px;
  border-radius: var(--radius-lg);
  background: var(--bg-light);
  color: var(--bg-dark);
  box-shadow: 0 36px 80px -38px rgba(0, 0, 0, 0.72);
}

.brief-card-top {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 29px;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--line-light);
  color: var(--primary);
  font-family: var(--font-mono);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.brief-card h3 {
  margin-bottom: 24px;
  font-family: var(--font-serif);
  font-size: 1.75rem;
  line-height: 1.3;
}

.brief-card ol {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.brief-card li {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 13px;
  padding: 15px 0;
  border-top: 1px solid var(--line-light);
}

.brief-card li > span {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 11px;
  background: var(--secondary);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 700;
}

.brief-card li:nth-child(even) > span {
  background: var(--primary);
}

.brief-card li p {
  align-self: center;
  margin: 0;
  color: var(--text-muted);
  font-size: 0.83rem;
  font-weight: 600;
  line-height: 1.5;
}

/* Sources + footer */
.references-section {
  padding: 72px 0;
  background: var(--bg-light);
}

.references-grid {
  display: grid;
  grid-template-columns: 0.7fr 1.3fr;
  gap: 80px;
  align-items: start;
}

.references-grid h2 {
  margin-bottom: 0;
  font-size: 2rem;
}

.references-grid ol {
  display: grid;
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
  counter-reset: reference;
}

.references-grid li {
  counter-increment: reference;
}

.references-grid a {
  display: grid;
  grid-template-columns: 28px 1fr;
  align-items: baseline;
  gap: 10px;
  padding-bottom: 11px;
  border-bottom: 1px solid var(--line-light);
  color: var(--text-muted);
  font-size: 0.8rem;
}

.references-grid a::before {
  content: counter(reference, decimal-leading-zero);
  color: var(--primary);
  font-family: var(--font-mono);
  font-size: 0.61rem;
  font-weight: 700;
}

.site-footer {
  padding: 54px 0 24px;
  background: var(--bg-darker);
  color: var(--white);
}

.footer-grid {
  display: grid;
  grid-template-columns: 130px 1fr auto;
  align-items: center;
  gap: 45px;
}

.footer-brand img {
  width: 110px;
  height: 110px;
  object-fit: contain;
}

.footer-grid > p {
  max-width: 470px;
  margin-bottom: 0;
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.88rem;
}

.footer-grid nav {
  display: flex;
  gap: 18px;
}

.footer-grid nav a {
  color: rgba(255, 255, 255, 0.74);
  font-size: 0.78rem;
  font-weight: 700;
}

.footer-grid nav a:hover {
  color: var(--secondary);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.36);
  font-family: var(--font-mono);
  font-size: 0.57rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

@media (max-width: 1080px) {
  .desktop-nav {
    display: none;
  }

  .brand-link {
    margin-right: auto;
  }

  .hero-grid,
  .proof-grid,
  .contact-grid {
    grid-template-columns: 1fr 0.9fr;
    gap: 45px;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .metric-card {
    min-height: 260px;
  }

  .challenge-card {
    grid-column: span 3;
  }

  .challenge-card:nth-child(5) {
    grid-column: 2 / span 4;
  }

  .principles-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 860px) {
  .section-shell,
  .nav-shell {
    width: min(100% - 36px, 720px);
  }

  .desktop-contact {
    display: none;
  }

  .mobile-menu {
    position: relative;
    display: block;
  }

  .mobile-menu summary {
    display: grid;
    place-items: center;
    min-width: 66px;
    min-height: 42px;
    padding: 8px 14px;
    border: 1px solid var(--line-light);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 700;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu[open] summary {
    background: var(--bg-dark);
    color: var(--white);
  }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 13px);
    right: 0;
    width: min(280px, calc(100vw - 36px));
    display: grid;
    padding: 12px;
    border: 1px solid var(--line-light);
    border-radius: 18px;
    background: var(--bg-light);
    box-shadow: var(--shadow);
  }

  .mobile-menu nav a {
    padding: 11px 12px;
    border-bottom: 1px solid var(--line-light);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .mobile-menu nav a:last-child {
    margin-top: 8px;
    border-bottom: 0;
    border-radius: 12px;
    background: var(--bg-dark);
    color: var(--white);
    text-align: center;
  }

  .hero {
    padding: 82px 0 86px;
  }

  .hero-grid,
  .proof-grid,
  .contact-grid,
  .split-heading,
  .pilot-intro,
  .faq-grid,
  .references-grid {
    grid-template-columns: 1fr;
  }

  .hero-grid,
  .proof-grid,
  .contact-grid {
    gap: 56px;
  }

  .hero-copy h1 {
    font-size: clamp(3rem, 10vw, 4.7rem);
  }

  .split-heading,
  .pilot-intro,
  .faq-grid,
  .references-grid {
    gap: 28px;
  }

  .challenge-section,
  .approach-section,
  .pilot-section,
  .audience-section,
  .proof-section,
  .faq-section,
  .contact-section {
    padding: 84px 0;
  }

  .challenge-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .challenge-card,
  .challenge-card:nth-child(4),
  .challenge-card:nth-child(5) {
    grid-column: auto;
    min-height: 390px;
  }

  .challenge-card:nth-child(5) {
    grid-column: 1 / -1;
    min-height: 340px;
  }

  .solution-header {
    display: none;
  }

  .solution-row:not(.solution-header) {
    grid-template-columns: 1fr;
    padding: 21px;
  }

  .solution-row > div {
    padding: 11px 0;
    border-right: 0;
  }

  .solution-row > div::before {
    content: attr(data-label);
    display: block;
    margin-bottom: 5px;
    color: var(--secondary);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .solution-row:not(.solution-header) > div:first-child {
    grid-template-columns: 30px 1fr;
  }

  .solution-row:not(.solution-header) > div:first-child::before {
    grid-column: 1 / -1;
  }

  .pilot-promise {
    width: min(100%, 330px);
  }

  .pilot-timeline {
    grid-template-columns: repeat(2, 1fr);
    gap: 38px 0;
  }

  .pilot-timeline li:nth-child(2) .phase-line i,
  .pilot-timeline li:last-child .phase-line i {
    display: none;
  }

  .measurement-card {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .audience-grid {
    grid-template-columns: 1fr;
  }

  .audience-grid article {
    min-height: 240px;
  }

  .faq-heading {
    position: static;
  }

  .references-grid {
    gap: 35px;
  }

  .footer-grid {
    grid-template-columns: 100px 1fr;
  }

  .footer-grid nav {
    grid-column: 1 / -1;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
}

@media (max-width: 600px) {
  .section-shell,
  .nav-shell {
    width: min(100% - 28px, 520px);
  }

  .nav-shell {
    min-height: 72px;
  }

  .brand-link {
    min-width: 0;
  }

  .brand-link img {
    width: 40px;
    height: 40px;
  }

  .brand-link small {
    display: none;
  }

  .brand-link strong {
    font-size: 0.91rem;
  }

  .hero {
    padding: 68px 0 72px;
  }

  .hero-copy h1 {
    font-size: clamp(2.7rem, 13vw, 3.85rem);
  }

  .hero-actions,
  .proof-actions,
  .contact-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .hero-actions .button-primary,
  .hero-actions .button-secondary,
  .proof-actions .button-primary,
  .contact-actions .button-primary {
    width: 100%;
  }

  .hero-system {
    padding: 18px;
    border-radius: 24px;
  }

  .system-flow li {
    grid-template-columns: 40px 1fr;
    gap: 11px;
    padding: 11px;
  }

  .system-flow li > span {
    width: 38px;
    height: 38px;
    border-radius: 11px;
  }

  .system-flow li:not(:last-child)::after {
    left: 21px;
  }

  .evidence-band {
    padding: 72px 0 68px;
  }

  .metrics-grid,
  .challenge-grid,
  .principles-grid,
  .pilot-timeline,
  .measurement-card ul,
  .proof-stats {
    grid-template-columns: 1fr;
  }

  .metric-card {
    min-height: 230px;
  }

  .challenge-card,
  .challenge-card:nth-child(4),
  .challenge-card:nth-child(5) {
    grid-column: auto;
    min-height: 0;
  }

  .challenge-card > p {
    margin-bottom: 28px;
  }

  .scope-banner {
    grid-template-columns: 1fr;
    padding: 26px;
  }

  .scope-mark {
    width: 68px;
    height: 68px;
    font-size: 2.5rem;
  }

  .section-heading h2,
  .pilot-intro h2,
  .proof-copy h2,
  .contact-copy h2 {
    font-size: clamp(2.25rem, 11vw, 3.3rem);
  }

  .principles-grid article {
    min-height: 200px;
  }

  .pilot-timeline {
    gap: 34px;
  }

  .pilot-timeline li {
    padding-right: 0;
  }

  .pilot-timeline .phase-line i {
    display: block !important;
  }

  .pilot-timeline li:last-child .phase-line i {
    display: none !important;
  }

  .measurement-card {
    padding: 27px;
  }

  .audience-grid article > span {
    margin-bottom: 42px;
  }

  .proof-stat:first-child {
    grid-column: auto;
  }

  .faq-list summary {
    font-size: 1rem;
  }

  .faq-list details > p {
    padding-right: 0;
  }

  .brief-card {
    padding: 23px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .footer-brand img {
    width: 86px;
    height: 86px;
  }

  .footer-grid nav {
    grid-column: auto;
    flex-wrap: wrap;
  }

  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
  }
}
